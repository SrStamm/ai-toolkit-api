# ============================================================
# ts-agent — environment template
# Copy to .env and fill in the values you need.
# ============================================================

# FastAPI RAG endpoints (set automatically in Docker Compose)
RAG_URL=http://localhost:8000/rag

# Redis (session memory)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379  # overrides host/port when set

# Provider API keys (referenced by src/config/providers.yaml via api_key_env)
MISTRAL_API_KEY=
GROQ_API_KEY=
