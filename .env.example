# ============================================================
# AI Toolkit API — environment template
# Copy to .env and fill in the values you need.
# ============================================================

# --- LLM providers ---
# Primary provider (required for hosted providers)
P_PROVIDER=mistral
P_API_KEY=
P_MODEL=mistral-small-latest
# P_URL=

# Fallback provider (used when the primary fails / circuit opens)
F_PROVIDER=ollama
F_API_KEY=
F_MODEL=qwen2.5:7b
F_URL=http://host.docker.internal:11434

# Provider API keys (referenced by app/config/providers.yaml via api_key_env)
MISTRAL_API_KEY=
GROQ_API_KEY=

# --- Redis ---
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- App ---
ENVIRONMENT=development
DEBUG=false
# ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
